# Supabase — get these from your Supabase project: Settings -> API
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" secret key (SERVER ONLY — never exposed to the browser).
# Used for privileged server actions like granting starter credits.
SUPABASE_SERVICE_ROLE_KEY=

# --- Error tracking (optional) -------------------------------------------
# Sentry stays off until the DSN is set. Get it from sentry.io:
# Project → Settings → Client Keys (DSN). Safe to expose to the browser.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: upload source maps so stack traces show real file/line numbers.
# Create at sentry.io → Settings → Auth Tokens (scope: project:releases).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
